{
  "$comment": "Machine-readable manifest of what this project CLAIMS to have. The CLI's `doctor` subcommand validates every entry against filesystem reality and exits non-zero on drift (Philosophy 7, constitution-as-code). Beyond existence checks, doctor carries semantic guards (retired-phrase regex blacklist, entrypoint-pointer checks, meta-config validation, secret-hygiene scan) and the drift ratchet: every drift that escapes doctor adds the mechanical check that would have caught it. Read on demand, not in the boot set.",
  "project": "{{PROJECT_NAME}}",
  "agent_name": "{{AGENT_NAME}}",
  "version": "0.1.0",
  "archetype": "{{content-video | content-ebook | seo-tool-site | web-product | casual-game | other}}",
  "documents": [
    "documentation/CONSTITUTION.md",
    "documentation/INITIALIZATION.md",
    "documentation/WORKFLOW.md",
    "documentation/ROLES.md",
    "documentation/ARCHITECTURE.md",
    "documentation/IDENTITY.md",
    "documentation/SOUL.md",
    "documentation/MEMORY.md",
    "documentation/NEXT_SESSION.md",
    "documentation/CHANGELOG.md",
    "documentation/configuration.json"
  ],
  "boot_set": [
    "documentation/CONSTITUTION.md",
    "documentation/IDENTITY.md",
    "documentation/SOUL.md",
    "documentation/WORKFLOW.md",
    "documentation/ROLES.md",
    "documentation/NEXT_SESSION.md",
    "documentation/MEMORY.md"
  ],
  "agents": [
    { "type": "{{name}}", "file": ".claude/agents/{{name}}.md", "step": "{{①}}", "invocation": "parallel-batch|singleton", "status": "registered|built" },
    { "type": "dev-maintainer", "file": ".claude/agents/dev-maintainer.md", "step": "as-needed", "invocation": "singleton", "status": "registered" }
  ],
  "partners": [
    { "$comment": "external contract partners (invocation: external-bridge) — delete if none",
      "name": "{{partner}}", "capabilities": "{{what it does}}", "protocol": "documentation/playbooks/partner_protocol_{{partner}}.md", "status": "registered|active" }
  ],
  "skills": {
    "lifecycle": ["start-session", "finalize-session", "self-reflection", "self-reflection-cli"],
    "local": [
      { "name": "{{skill}}", "built_from": ["{{MCP server}}", "{{core}} {{cmd}}"], "status": "registered|built" }
    ],
    "global_reused": ["{{messaging}}", "{{image-gen}}", "{{research}}"]
  },
  "cli": {
    "launcher": "{{./core}}",
    "subcommands": ["doctor", "qa", "validate", "ship", "{{memory}}", "{{key production subcommands…}}"],
    "consumers": {
      "$comment": "reverse index of shared capability (Philosophy 3, layers ④–⑤): which skills/agents consume each subcommand — so a change here shows its blast radius",
      "{{cmd}}": ["skill:{{skill}}", "agent:{{name}}"]
    }
  },
  "qa_chain": {
    "$comment": "Philosophy 10 — quality is a deterministic gate. per_step: each spine step's QA command (workers must pass it before reporting: no self-check, no report). final_validate + ship are CEO-executed. Steps still executed artisanally (no function yet) are industrialization debt.",
    "per_step": { "{{step}}": "{{core}} qa {{step}}" },
    "final_validate": "{{core}} validate",
    "ship": "{{core}} ship",
    "artisanal_debt": ["{{steps with no executing function yet}}"]
  },
  "architecture": {
    "$comment": "Philosophy 11 — the code's own baseline. `doctor` mechanizes these one at a time (prose → convention → check); the drift ratchet applies: every architectural drift a human catches ships with the check that would have caught it. open_gaps/exceptions counts are ratchet counters — they may shrink, never grow.",
    "baseline": "documentation/ARCHITECTURE.md",
    "stack": "{{language / framework / runtime}}",
    "inherits": { "name": "{{none | shared horizontal baseline name}}", "version": "{{X.Y}}" },
    "checks": ["{{dependency-direction scan}}", "{{ownership symbols resolve}}", "{{exception expiry}}", "{{violation counters}}"],
    "open_gaps": 0,
    "exceptions": 0,
    "reality_signals": ["{{the ≥1 oracle from outside our own loop — Philosophy 10}}"]
  },
  "memory": {
    "lightweight": "documentation/MEMORY.md",
    "vector_db": { "enabled": false, "store": "{{./chroma/}}", "provider": "openrouter", "model": "{{model}}" }
  },
  "lifeline_store": "{{./<lifeline>.db}}",
  "gitignored": ["{{./chroma/}}", "{{./<lifeline>.db}}", "{{.env}}", "build/"]
}
